{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "monitoring chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storageClassName": {
          "type": "string"
        },
        "commonLabels": {
          "type": "object"
        }
      }
    },
    "grafana": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "admin": {
          "type": "object",
          "properties": {
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "nodePort": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "persistence": {
          "$ref": "#/definitions/storage"
        },
        "replaceExistingDatasources": {
          "type": "boolean"
        },
        "extraEnv": {
          "type": "array"
        }
      }
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$"
        },
        "scrapeInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "persistence": {
          "$ref": "#/definitions/storage"
        }
      }
    },
    "loki": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dashboard": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+(h|m|s)$"
        },
        "persistence": {
          "$ref": "#/definitions/storage"
        }
      }
    },
    "promtail": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostNetwork": {
          "type": "boolean"
        },
        "tolerations": {
          "type": "array"
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "kafka": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/definitions/image"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "extraBrokers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "saslMechanism": {
              "type": "string",
              "enum": [
                "plain",
                "scram-sha256",
                "scram-sha512"
              ]
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "insecureSkipVerify": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "mariadb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/definitions/image"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        },
        "mongodb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "image": {
              "$ref": "#/definitions/image"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "authDatabase": {
              "type": "string"
            },
            "tls": {
              "type": "boolean"
            },
            "directConnect": {
              "type": "boolean"
            },
            "collectAll": {
              "type": "boolean"
            }
          }
        },
        "minio": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "metricsPath": {
              "type": "string"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "http",
                "https"
              ]
            },
            "bearerToken": {
              "type": "string"
            },
            "sites": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "targets"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "bearerToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "$ref": "#/definitions/port"
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "client": {
              "type": "string",
              "enum": [
                "standalone",
                "cluster",
                "sentinel"
              ]
            },
            "tls": {
              "type": "boolean"
            }
          }
        },
        "kubernetes": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cadvisor": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "kubelet",
                    "apiserver-proxy"
                  ]
                },
                "insecureSkipVerify": {
                  "type": "boolean"
                },
                "scrapeInterval": {
                  "type": "string",
                  "pattern": "^([1-9]|[12][0-9]|30)s$"
                }
              }
            },
            "kubeStateMetrics": {
              "type": "object",
              "properties": {
                "image": {
                  "$ref": "#/definitions/image"
                },
                "scrapeInterval": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m)$"
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}

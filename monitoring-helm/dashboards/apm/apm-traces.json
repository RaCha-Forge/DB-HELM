{
  "uid": "apm-traces",
  "title": "APM \u00b7 Traces",
  "description": "Trace explorer: search traces by application, status and duration, then read the waterfall, span table and logs of the selected trace.",
  "tags": [
    "apm",
    "traces",
    "fyno"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "APM",
      "tags": [
        "apm"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"traces_span_metrics_calls_total|nodejs_eventloop_utilization_ratio\",service_name!=\"\"}, service_name)",
          "refId": "application"
        },
        "definition": "label_values({__name__=~\"traces_span_metrics_calls_total|nodejs_eventloop_utilization_ratio\",service_name!=\"\"}, service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "status",
        "label": "Status",
        "type": "custom",
        "query": "All : && true,Errors only : && status = error,OK only : && status = ok",
        "current": {
          "selected": true,
          "text": "All",
          "value": "&& true"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "&& true"
          },
          {
            "selected": false,
            "text": "Errors only",
            "value": "&& status = error"
          },
          {
            "selected": false,
            "text": "OK only",
            "value": "&& status = ok"
          }
        ]
      },
      {
        "name": "mindur",
        "label": "Min duration",
        "type": "custom",
        "query": "any : 0ms,100ms : 100ms,500ms : 500ms,1s : 1s,2s : 2s,5s : 5s",
        "current": {
          "selected": true,
          "text": "any",
          "value": "0ms"
        },
        "options": [
          {
            "selected": true,
            "text": "any",
            "value": "0ms"
          },
          {
            "selected": false,
            "text": "100ms",
            "value": "100ms"
          },
          {
            "selected": false,
            "text": "500ms",
            "value": "500ms"
          },
          {
            "selected": false,
            "text": "1s",
            "value": "1s"
          },
          {
            "selected": false,
            "text": "2s",
            "value": "2s"
          },
          {
            "selected": false,
            "text": "5s",
            "value": "5s"
          }
        ]
      },
      {
        "name": "filter",
        "label": "Filter (TraceQL)",
        "type": "textbox",
        "query": "true",
        "current": {
          "selected": false,
          "text": "true",
          "value": "true"
        },
        "options": [
          {
            "selected": true,
            "text": "true",
            "value": "true"
          }
        ]
      },
      {
        "name": "traceid",
        "label": "Trace ID",
        "type": "textbox",
        "query": "00000000000000000000000000000000",
        "current": {
          "selected": false,
          "text": "00000000000000000000000000000000",
          "value": "00000000000000000000000000000000"
        },
        "options": [
          {
            "selected": true,
            "text": "00000000000000000000000000000000",
            "value": "00000000000000000000000000000000"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Find a trace on the left, read it on the right",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Traces",
      "description": "Traces matching the filters above, newest first. Click a Trace ID to load it on the right.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 38,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${application:regex}\" $status && duration > $mindur && ($filter) }",
          "limit": 50,
          "tableType": "traces",
          "filters": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Trace explorer",
                    "url": "/d/apm-traces/apm-traces?var-traceid=${__value.raw}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 500
                    },
                    {
                      "color": "red",
                      "value": 1500
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Start time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 165
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      },
      "id": 2
    },
    {
      "type": "text",
      "title": "Selected trace",
      "gridPos": {
        "h": 3,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "options": {
        "mode": "markdown",
        "content": "**Trace ID** `$traceid`  \u2014 pick another trace in the list on the left, or paste a Trace ID in the box at the top."
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Duration",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 8,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$traceid\" } | select(name, kind, resource.service.name, span.db.system, status)",
          "limit": 1000,
          "tableType": "spans",
          "filters": [],
          "spss": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "ns",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "/^Duration$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Spans",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 11,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$traceid\" } | select(name, kind, resource.service.name, span.db.system, status)",
          "limit": 1000,
          "tableType": "spans",
          "filters": [],
          "spss": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^Span ID$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Services",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 14,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$traceid\" } | select(name, kind, resource.service.name, span.db.system, status)",
          "limit": 1000,
          "tableType": "spans",
          "filters": [],
          "spss": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "distinctCount"
          ],
          "fields": "/^service\\.name$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Error spans",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 17,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$traceid\" && status = error }",
          "limit": 1000,
          "tableType": "spans",
          "filters": [],
          "spss": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^Span ID$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 7
    },
    {
      "type": "stat",
      "title": "Start",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$traceid\" } | select(name, kind, resource.service.name, span.db.system, status)",
          "limit": 1000,
          "tableType": "spans",
          "filters": [],
          "spss": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "-",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "dateTimeAsLocal"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "min"
          ],
          "fields": "/^Start time$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 8
    },
    {
      "type": "traces",
      "title": "Waterfall \u2014 every span of the trace (click a span for attributes, logs and metrics)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 15,
        "w": 16,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "$traceid",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Span table",
      "description": "All spans of the trace. The Exec bar is the span duration relative to the longest span (the root). Use the column filters to focus on one service or database.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ trace:id = \"$traceid\" } | select(name, kind, resource.service.name, span.db.system, status)",
          "limit": 500,
          "tableType": "spans",
          "filters": [],
          "spss": 1000
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "traceService": true,
              "traceName": true,
              "spanID": true
            },
            "renameByName": {
              "service.name": "Application",
              "kind": "Kind",
              "span.db.system": "Component",
              "db.system": "Component",
              "status": "Status"
            },
            "indexByName": {
              "name": 0,
              "service.name": 1,
              "kind": 2,
              "span.db.system": 3,
              "db.system": 3,
              "time": 4,
              "duration": 5,
              "status": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Start time"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Exec"
              },
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Span name"
              },
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Start time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "id": 10
    },
    {
      "type": "logs",
      "title": "Logs of this trace",
      "description": "Log lines (from any application) that carry this trace id.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=~\".+\"} |= \"$traceid\"",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      },
      "id": 11
    }
  ]
}